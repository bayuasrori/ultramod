{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bayuasrori/ultramod",
    "type": "project",
    "description": "A code-first modular application platform for Laravel. Install apps, extend them without forking, keep writing normal Laravel.",
    "keywords": [
        "laravel",
        "platform",
        "modular",
        "modules",
        "apps",
        "modular-monolith"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "PlatformApps\\Hello\\": "apps/hello/src/",
            "PlatformApps\\Notes\\": "apps/notes/src/",
            "PlatformApps\\Tasks\\": "apps/tasks/src/",
            "PlatformApps\\CookBook\\": "apps/cook-book/src/",
            "PlatformApps\\Antrian\\": "apps/antrian/src/",
            "PlatformApps\\Kanban\\": "apps/kanban/src/",
            "PlatformApps\\Calendar\\": "apps/calendar/src/",
            "PlatformApps\\Bookmarks\\": "apps/bookmarks/src/",
            "PlatformApps\\Products\\": "apps/products/src/",
            "PlatformApps\\Customers\\": "apps/customers/src/",
            "PlatformApps\\AiAssistant\\": "apps/ai-assistant/src/",
            "PlatformApps\\NotesStatus\\": "apps/notes-status/src/",
            "PlatformApps\\FormBuilder\\": "apps/form-builder/src/",
            "PlatformApps\\AiAssistant\\Database\\Seeders\\": "apps/ai-assistant/database/seeders/",
            "PlatformApps\\Antrian\\Database\\Seeders\\": "apps/antrian/database/seeders/",
            "PlatformApps\\Bookmarks\\Database\\Seeders\\": "apps/bookmarks/database/seeders/",
            "PlatformApps\\Calendar\\Database\\Seeders\\": "apps/calendar/database/seeders/",
            "PlatformApps\\CookBook\\Database\\Seeders\\": "apps/cook-book/database/seeders/",
            "PlatformApps\\Customers\\Database\\Seeders\\": "apps/customers/database/seeders/",
            "PlatformApps\\FormBuilder\\Database\\Seeders\\": "apps/form-builder/database/seeders/",
            "PlatformApps\\Hello\\Database\\Seeders\\": "apps/hello/database/seeders/",
            "PlatformApps\\Kanban\\Database\\Seeders\\": "apps/kanban/database/seeders/",
            "PlatformApps\\Notes\\Database\\Seeders\\": "apps/notes/database/seeders/",
            "PlatformApps\\NotesStatus\\Database\\Seeders\\": "apps/notes-status/database/seeders/",
            "PlatformApps\\Products\\Database\\Seeders\\": "apps/products/database/seeders/",
            "PlatformApps\\Tasks\\Database\\Seeders\\": "apps/tasks/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --seed --ansi",
            "@php artisan platform:app:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/bayuasrori/ultramod",
    "support": {
        "issues": "https://github.com/bayuasrori/ultramod/issues",
        "source": "https://github.com/bayuasrori/ultramod"
    }
}
